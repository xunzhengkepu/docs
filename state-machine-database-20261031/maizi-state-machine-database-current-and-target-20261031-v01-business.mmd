  people {
    uuid id PK
    text name
    text wechat_id
  }
  doctors {
    uuid person_id PK,FK
    text display_name
  }
  employees {
    uuid person_id PK,FK
    text_array work_roles
    boolean is_active
  }
  companies {
    uuid id PK
    text name
  }
  company_contacts {
    uuid id PK
    uuid person_id FK
    uuid company_id FK
    text role
  }
  doctor_companies {
    uuid doctor_id PK,FK
    uuid company_id PK,FK
    text relationship
  }
  projects {
    uuid id PK
    text name
    text requirements
  }
  project_people {
    uuid project_id PK,FK
    uuid person_id PK,FK
    text_array roles
  }
  tasks {
    uuid id PK
    uuid doctor_id FK
    uuid project_id FK
    text status
    bigint status_version
    uuid updated_by FK
  }
  status_history {
    uuid id PK
    uuid task_id FK
    bigint version
    text from_status
    text to_status
    text change_source
    text source_message_uid
    uuid changed_by FK
  }
  files {
    uuid id PK
    uuid task_id FK
    text source_message_uid
    text kind
    text sha256
    text download_status
  }
  videos {
    uuid id PK
    uuid task_id FK
    text source_message_uid
    text kind
    text sha256
    text download_status
  }
  publications {
    uuid id PK
    uuid task_id FK
    uuid video_id FK
    text status
    text source_message_uid
    uuid confirmed_by FK
  }
