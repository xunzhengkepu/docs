flowchart TB
    cooperation["医生与项目合作关系"] --> allowed{"允许新增发稿？"}
    allowed -->|"否"| hold["暂缓新增；已有作品继续推进"]
    allowed -->|"是"| work["作品建档：稳定作品编号"]
    work --> script["文案版本提交"]
    script --> scriptReview["文案按规定路线审核"]
    scriptReview --> scriptPass{"当前版本审核通过？"}
    scriptPass -->|"明确修改"| reviseScript["修改文案，形成新版本"]
    reviseScript --> script
    scriptPass -->|"证据不清"| scriptCheck["人工核对对象、版本、身份"]
    scriptCheck -.->|"确认后重新判断"| scriptReview
    scriptPass -->|"通过"| record["医生录制、上传素材"]
    record --> qc{"素材收齐且可用？"}
    qc -->|"缺片或不可用"| retake["补录、补传或重新质检"]
    retake --> record
    qc -->|"确认可用"| rawOk["记录素材确认；启动两个工作日交付期限"]
    rawOk --> edit["剪辑并提交确切成片版本"]
    edit --> cutReview["成片按规定路线审核"]
    cutReview --> cutPass{"当前版本审核通过？"}
    cutPass -->|"明确修改"| cutRevision["返工后形成新版本"]
    cutRevision --> edit
    cutPass -->|"证据不清"| cutCheck["人工核对对象、版本、身份"]
    cutCheck -.->|"确认后重新判断"| cutReview
    cutPass -->|"通过"| handoff["按约定交付终版，登记接收方、时间与位置"]
    handoff --> schedule["确认档期；没有档期则提示补充"]
    schedule --> published["平台实际发布，登记链接与发布时间"]
    published --> count["更新作品产量与平台发布数"]
    classDef ordinary fill:#eef6f5,stroke:#478a83,color:#183f40
    classDef decision fill:#fff4dc,stroke:#ba8932,color:#6d4b15
    classDef exception fill:#fff0ed,stroke:#c47f69,color:#713a2b
    classDef result fill:#dcefe3,stroke:#4f8b62,color:#244c2d
    class cooperation,work,script,scriptReview,record,rawOk,edit,cutReview,handoff,schedule ordinary
    class allowed,scriptPass,qc,cutPass decision
    class hold,reviseScript,scriptCheck,retake,cutRevision,cutCheck exception
    class published,count result
