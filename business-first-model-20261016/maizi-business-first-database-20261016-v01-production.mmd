erDiagram
    videos ||--o{ status_changes : "已生效修改"
    videos o|--o{ files : "归属可待核实"
    videos ||--o{ reviews : "审核要求"
    files o|--o{ reviews : "具体版本可待补"
    files ||--o{ deliveries : "交付版本"
    videos ||--o{ publications : "定时及发布"
    files o|--o{ publications : "发布版本可待补"
