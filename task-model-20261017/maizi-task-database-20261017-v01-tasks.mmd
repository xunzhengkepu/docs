erDiagram
    tasks ||--o{ status_history : "状态改动"
    tasks o|--o{ videos : "视频归属可待核实"
    tasks o|--o{ files : "文件归属可待核实"
    tasks ||--o{ publications : "发布安排与结果"
    videos o|--o{ publications : "发布版本可未知"
    tasks["制作任务 · tasks"] {
        UUID id PK
        text title
        UUID doctor_id FK
        UUID project_id FK
        text content_type
        text status
        bigint status_version
        text note
        UUID updated_by FK
        timestamptz created_at
        timestamptz updated_at
    }
    status_history["状态历史 · status_history"] {
        UUID id PK
        UUID task_id FK
        bigint version
        text from_status
        text to_status
        timestamptz changed_at
        text change_source
        UUID changed_by FK
        text source_message_uid
    }
    videos["视频文件 · videos"] {
        UUID id PK
        UUID task_id FK
        text source_message_uid
        text storage_path
        text download_status
        text sha256
        text kind
        bigint size_bytes
        bigint duration_ms
    }
    files["文稿与资料 · files"] {
        UUID id PK
        UUID task_id FK
        text source_message_uid
        text storage_path
        text download_status
        text sha256
        text filename
        text kind
        text external_url
    }
    publications["发布安排与结果 · publications"] {
        UUID id PK
        UUID task_id FK
        UUID video_id FK
        text platform
        text status
        timestamptz scheduled_at
        timestamptz published_at
        text url
        text platform_video_id
        text source_message_uid
        UUID confirmed_by FK
        timestamptz confirmed_at
        bigint view_count
        timestamptz stats_updated_at
    }
